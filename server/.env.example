# Port serwera (Render ustawia go automatycznie)
PORT=4000

# Połączenie z MongoDB (np. MongoDB Atlas). Bez tego gry trzymane są tylko w pamięci.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/kozia-mafia

# Hasło do panelu hosta (admina)
ADMIN_PASSWORD=zmien-mnie

# Sekret do podpisywania tokenów JWT (dowolny długi losowy ciąg)
JWT_SECRET=bardzo-dlugi-losowy-sekret

# Adres frontendu (Vercel). Kilka adresów oddziel przecinkiem.
CLIENT_URL=http://localhost:5173

# Powiadomienia push (wygeneruj: npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
